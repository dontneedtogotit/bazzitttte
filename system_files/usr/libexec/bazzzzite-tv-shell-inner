#!/usr/bin/env bash
# bazzzzite-tv-shell-inner: runs as Cage's child, so WAYLAND_DISPLAY is set.
#
# Cage is a bare compositor and does not run the usual session startup that
# publishes the display to the systemd user manager. Without this, user units
# launched later (the YouTube app) inherit no WAYLAND_DISPLAY, fall back to the
# DRM backend, and fail because this session already holds the display.
set -euo pipefail

systemctl --user import-environment WAYLAND_DISPLAY XDG_RUNTIME_DIR 2>/dev/null || true
dbus-update-activation-environment --systemd WAYLAND_DISPLAY XDG_RUNTIME_DIR 2>/dev/null || true
systemctl --user start graphical-session.target 2>/dev/null || true

# Keep the HTTP cache in the runtime directory, which is tmpfs and therefore
# empty after every boot. The shell is served from loopback, so a persistent
# cache saves nothing -- but it did survive image updates and keep showing the
# old interface, which looked exactly like the update having failed.
CACHE_DIR="${XDG_RUNTIME_DIR:-/tmp}/bazzzzite-shell-cache"
rm -rf "$CACHE_DIR"

# Fedora's chromium package installs the binary as chromium-browser, not
# chromium, so hardcoding /usr/bin/chromium launches nothing and Cage sits on a
# black screen. Resolve whichever name the package actually provides.
CHROMIUM=""
for candidate in chromium chromium-browser google-chrome google-chrome-stable chrome; do
    if command -v "$candidate" >/dev/null 2>&1; then
        CHROMIUM="$(command -v "$candidate")"
        break
    fi
done
if [[ -z "$CHROMIUM" ]]; then
    echo "TV shell: no chromium/chrome binary found on PATH" >&2
    exit 1
fi

exec "$CHROMIUM" \
    --disk-cache-dir="$CACHE_DIR" \
    --kiosk --noerrdialogs --disable-infobars \
    --disable-features=Translate \
    --ozone-platform=wayland \
    --enable-features=VaapiVideoDecoder \
    --ignore-gpu-blocklist \
    --enable-zero-copy \
    --disable-pinch --disable-zoom \
    --disable-session-crashed-bubble \
    http://localhost:8080
