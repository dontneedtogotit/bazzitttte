#!/usr/bin/env bash
# bazzzzite-autologin-setup: point the display manager at the TV session.
#
# The username isn't known at image build time (it's whatever the installer
# created), so the autologin config is written at boot from the first regular
# account on the system. Runs before display-manager.service.
set -euo pipefail

USER_NAME=$(awk -F: '($3 >= 1000 && $3 < 60000) { print $1; exit }' /etc/passwd)

if [[ -z "${USER_NAME}" ]]; then
    echo "No regular user found; leaving autologin unconfigured." >&2
    exit 0
fi

CONF_DIR=/etc/sddm.conf.d
mkdir -p "$CONF_DIR"

# SDDM merges this directory alphabetically and the last file to set a key
# wins, so the TV session has to be written under a name that sorts last. A
# "10-" name loses to anything later: a stale zz-bazzitttte-autologin.conf from
# an earlier iteration of this image was pinning Session=plasma and booting the
# desktop instead of the TV shell. /etc survives a bootc update, so it silently
# outlived every upgrade. Only names this project has written are removed.
rm -f "${CONF_DIR}/10-bazzzzite-autologin.conf" \
      "${CONF_DIR}/zz-bazzitttte-autologin.conf"

cat > "${CONF_DIR}/zzz-bazzzzite-autologin.conf" <<EOF
# Generated by bazzzzite-autologin-setup. Edits will be overwritten at boot.
[Autologin]
User=${USER_NAME}
Session=bazzzzite-tv.desktop
Relogin=true
EOF

echo "Autologin configured for ${USER_NAME} -> bazzzzite-tv.desktop"
