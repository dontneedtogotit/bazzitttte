#!/usr/bin/env bash
# bazzzzite-autologin-setup: point the display manager at the TV session.
#
# The username isn't known at image build time (it's whatever the installer
# created), so the autologin config is written at boot from the first regular
# account on the system. Runs before display-manager.service.
set -euo pipefail

USER_NAME=$(awk -F: '($3 >= 1000 && $3 < 60000) { print $1; exit }' /etc/passwd)

if [[ -z "${USER_NAME}" ]]; then
    echo "No regular user found; leaving autologin unconfigured." >&2
    exit 0
fi

# Which display manager sits behind display-manager.service decides where the
# drop-in has to live. A current Kinoite/Bazzite base ships plasma-login-manager
# -- KDE's successor to SDDM -- which keeps SDDM's config format but reads
# /etc/plasmalogin.conf.d and never looks at /etc/sddm.conf.d. A drop-in written
# only to the SDDM path leaves the TV sitting at a greeter, which is exactly
# what this image did.
#
# Both paths are written rather than just the detected one. Each manager ignores
# the other's directory, so the unused file is inert, and probing instead (for a
# binary on PATH, or for an already-existing directory) can find neither on a
# clean install and silently configure nothing -- the same greeter, with no
# clue why. Writing both cannot land the TV at a greeter through a bad guess.
CONF_DIRS=(/etc/plasmalogin.conf.d /etc/sddm.conf.d)

dm_exec=$(systemctl show -p ExecStart --value display-manager.service 2>/dev/null \
    | sed -n 's/.*path=\([^ ;]*\).*/\1/p' | head -1)
if [[ -n "$dm_exec" ]]; then
    echo "Display manager: $(basename "$dm_exec") (${dm_exec})"
else
    echo "Could not identify display-manager.service; writing all known paths." >&2
fi

for CONF_DIR in "${CONF_DIRS[@]}"; do
    mkdir -p "$CONF_DIR"

    # Both managers merge this directory alphabetically and the last file to set
    # a key wins, so our file has to be written under a name that sorts last. A
    # "10-" name loses to anything later: a stale zz-bazzitttte-autologin.conf
    # from an earlier iteration of this image was pinning a different session
    # and /etc survives a bootc update, so it silently outlived every upgrade.
    # Only names this project has written are removed.
    rm -f "${CONF_DIR}/10-bazzzzite-autologin.conf" \
          "${CONF_DIR}/zz-bazzitttte-autologin.conf"

    # Autologin targets the regular Plasma desktop, not a dedicated kiosk
    # session: the TV shell then launches inside that session via XDG autostart,
    # stacked fullscreen over the desktop. If the shell ever fails to start or
    # is exited, the user lands on a working Bazzite desktop instead of a black
    # screen -- the old Cage kiosk session (bazzzzite-tv.desktop) remains
    # installed and selectable as a fallback.
    cat > "${CONF_DIR}/zzz-bazzzzite-autologin.conf" <<EOF
# Generated by bazzzzite-autologin-setup. Edits will be overwritten at boot.
[Autologin]
User=${USER_NAME}
Session=plasma.desktop
Relogin=true
EOF

    echo "Autologin configured for ${USER_NAME} -> plasma.desktop (${CONF_DIR})"
done
