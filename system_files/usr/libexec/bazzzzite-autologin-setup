#!/usr/bin/env bash
# bazzzzite-autologin-setup: point the display manager at the TV session.
#
# The username isn't known at image build time (it's whatever the installer
# created), so the autologin config is written at boot from the first regular
# account on the system. Runs before display-manager.service.
set -euo pipefail

USER_NAME=$(awk -F: '($3 >= 1000 && $3 < 60000) { print $1; exit }' /etc/passwd)

if [[ -z "${USER_NAME}" ]]; then
    echo "No regular user found; leaving autologin unconfigured." >&2
    exit 0
fi

mkdir -p /etc/sddm.conf.d
cat > /etc/sddm.conf.d/10-bazzzzite-autologin.conf <<EOF
# Generated by bazzzzite-autologin-setup. Edits will be overwritten at boot.
[Autologin]
User=${USER_NAME}
Session=bazzzzite-tv.desktop
Relogin=true
EOF

echo "Autologin configured for ${USER_NAME} -> bazzzzite-tv.desktop"
