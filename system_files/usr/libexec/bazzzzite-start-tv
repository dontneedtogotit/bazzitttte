#!/usr/bin/env bash
# bazzzzite-start-tv: start Cage + Chromium as the first regular user
set -euo pipefail

USER_NAME=$(awk -F: '($3 >= 1000 && $3 < 60000) { print $1; exit }' /etc/passwd)
if [[ -z "${USER_NAME}" ]]; then
    echo "No regular user found yet, waiting..."
    sleep 5
    USER_NAME=$(awk -F: '($3 >= 1000 && $3 < 60000) { print $1; exit }' /etc/passwd)
fi

if [[ -z "${USER_NAME}" ]]; then
    echo "Still no regular user found, cannot start TV shell"
    exit 1
fi

USER_UID=$(id -u "${USER_NAME}")
export XDG_RUNTIME_DIR="/run/user/${USER_UID}"
export DISPLAY=":0"
export WAYLAND_DISPLAY="wayland-0"

echo "Starting TV shell as ${USER_NAME} (UID ${USER_UID})"

exec runuser -u "${USER_NAME}" -- /usr/bin/dbus-run-session -- /usr/bin/cage --br -s -- \
    /usr/bin/chromium --kiosk --noerrdialogs --disable-infobars \
    --disable-features=Translate --ozone-platform=wayland \
    --enable-features=VaapiVideoDecoder --ignore-gpu-blocklist \
    --enable-zero-copy \
    http://localhost:8080
