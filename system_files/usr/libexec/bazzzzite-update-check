#!/usr/bin/env bash
# bazzzzite-update-check: check for OS updates and notify
set -euo pipefail

if ! command -v bootc >/dev/null 2>&1; then
    echo "bootc not available, skipping OS update check" | systemd-cat -t bazzzzite-update-check
    exit 0
fi

set +e
OUTPUT=$(bootc upgrade --check 2>&1)
STATUS=$?
set -e

if [[ "$STATUS" -ne 0 ]]; then
    echo "Update check FAILED (exit $STATUS): $OUTPUT" | wall
elif echo "$OUTPUT" | grep -qi "update available"; then
    echo "System update available. Open Settings > System > Check for Updates." | wall
fi

echo "$OUTPUT" | systemd-cat -t bazzzzite-update-check
